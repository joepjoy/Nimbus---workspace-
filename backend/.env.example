# PostgreSQL connection string
DATABASE_URL="postgresql://nimbus:nimbus@localhost:5432/nimbus?schema=public"

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
NODE_ENV=development

# Origin of the frontend (used for CORS and password reset links)
CLIENT_URL="http://localhost:5173"
